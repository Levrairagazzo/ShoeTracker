# Copy to .env and fill in for your deployment.
# Domain the API should accept requests for once you have a real one (comma-separated for multiple hosts).
# Leave unset/commented to keep the default of accepting any host ("*").
ALLOWED_HOSTS=milesleft.run

# Bootstrap credentials for the single app-level login account. Only used on
# first boot, when the Users table is empty — leave unset to skip seeding
# (login stays unavailable until set). Changing these later has no effect
# once the account already exists.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me

# Automated database backups (see README, "Backing up the database"). Snapshots
# go to ./backups on the host; only the newest BACKUP_KEEP automated ones are
# kept. Manual snapshots from scripts/backup-db.sh are never pruned.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP=14

# Strava API app credentials (strava.com/settings/api). Leave unset to hide the
# "Connect Strava" option. STRAVA_REDIRECT_URI defaults to the production
# callback; set it to http://localhost:8080/api/strava/callback for local Docker.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
#STRAVA_REDIRECT_URI=https://milesleft.run/api/strava/callback
