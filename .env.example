# Copy to .env and fill in for your deployment.
# Domain the API should accept requests for once you have a real one (comma-separated for multiple hosts).
# Leave unset/commented to keep the default of accepting any host ("*").
ALLOWED_HOSTS=milesleft.run

# Bootstrap credentials for the single app-level login account. Only used on
# first boot, when the Users table is empty — leave unset to skip seeding
# (login stays unavailable until set). Changing these later has no effect
# once the account already exists.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=change-me
